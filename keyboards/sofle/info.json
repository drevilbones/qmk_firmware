{
  "keyboard_name": "Sofle",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },
    "build": {
        "lto": true
    },
    "usb": {
        "vid": "0xFC32"
    },
    "diode_direction": "COL2ROW",
    "qmk": {
        "tap_keycode_delay": 10
    },
    "split": {
        "enabled": true,
        "serial": {
            "pin": "GP1"
        },
        "transport": {
            "sync": {
                "matrix_state": true
            }
        }
    },
    "ps2": {
      "clock_pin": "GP3",
      "data_pin": "GP2",
      "driver": "vendor",
      "enabled": true,
      "mouse_enabled": true
    }
}
